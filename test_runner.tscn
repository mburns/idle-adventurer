[gd_scene load_steps=2 format=3 uid="uid://test_runner"]

[ext_resource type="Script" path="res://test_runner.gd" id="1_test_runner"]

[node name="TestRunner" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_test_runner")

[node name="Gut" type="Node" parent="."]
script = preload("res://addons/gut/gut.gd")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="TestResults" type="RichTextLabel" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true

[node name="RunTestsButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Run All Tests"

[connection signal="pressed" from="VBoxContainer/RunTestsButton" to="." method="_on_run_tests_button_pressed"]
