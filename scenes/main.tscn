layout_mode = 2
text = "Artisan"

[node name="ArtisanProgressBar" type="ProgressBar" parent="TabContainer/Profession/Artisan"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
max_value = 1.0
value = 0.0
show_percentage = false
mouse_filter = 2

