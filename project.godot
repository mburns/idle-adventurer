; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Idle Adventurer"
run/main_scene="res://scenes/start_screen.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

CharacterManager="*res://scripts/character_manager.gd"
DataLoader="*res://scripts/data_loader.gd"
GameEvents="*res://scripts/game_events.gd"
AnimationManager="*res://scripts/animation_manager.gd"
ThemeManager="*res://scripts/theme_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
