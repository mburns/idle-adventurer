; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Idle Adventurer"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

AutoloadManager="*res://scripts/core/autoload_manager.gd"
CharacterManager="*res://scripts/core/character_manager.gd"
DataLoader="*res://scripts/data/data_loader.gd"
GameEvents="*res://scripts/events/game_events.gd"
AnimationManager="*res://scripts/visual/animation_manager.gd"
ThemeManager="*res://scripts/visual/theme_manager.gd"
DebugConfig="res://scripts/core/debug_config.gd"

[display]

window/size/viewport_width=1200
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[import]

#Optimizeassetimportingfilesystem/import/blender/enabled=false
filesystem/import/fbx/enabled=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
