script = ExtResource("1")
name = "Adult Green Dragon (Chromatic)"
size = "Huge dragon"
type = "lawful evil"
alignment = "lawful evil"
armor_class = "19"
hit_points = "207"
speed = "40 ft., fly 80 ft., swim 40 ft."
abilities = {
"charisma": 17,
"constitution": 21,
"dexterity": 12,
"intelligence": 18,
"strength": 23,
"wisdom": 15
}
saving_throws = Array[String](["Dex +6", "Con +10", "Wis +7", "Cha +8"])
skills = Array[String](["Deception +8", "Insight +7", "Perception +12", "Persuasion +8", "Stealth +6"])
