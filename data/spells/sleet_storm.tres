[ext_resource type="Script" path="res://resources/spell_resource.gd" id="1_spell"]

[resource]
script = ExtResource("1_spell")
spell_name = "Sleet Storm"
level = 1
school = "evocation"
casting_time = "1 action"
spell_range = "150 feet"
components = "V, S, M (a pinch of dust and a few drops of water)"
duration = "Concentration, up to 1 minute"
description = "Until the spell ends, freezing rain and sleet fall in a 20-foot tall cylinder with a 40-foot radius centered on a point you choose within range. The area is heavily obscured, and exposed flames in the area are doused.

The ground in the area is covered with slick ice, making it difficult terrain. When a creature enters the spell's area for the first time on a turn or starts its turn there, it must make a Dexterity saving throw. On a failed save, it falls prone.

If a creature starts its turn in the spell's area and is concentrating on a spell, the creature must make a successful Constitution saving throw against your spell save DC or lose concentration."
higher_levels = ""
ritual = "false"
concentration = "false"
classes = ["wizard"]
damage_dice = "1d6"
damage_type = "acid"
saving_throw = "Dexterity"
attack_roll = "false"
area_of_effect = ""
scales_with_level = "true"
scaling_dice = "1d6"
scaling_levels = [5, 11, 17]
