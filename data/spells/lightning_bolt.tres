[ext_resource type="Script" path="res://resources/spell_resource.gd" id="1_spell"]

[resource]
script = ExtResource("1_spell")
spell_name = "Lightning Bolt"
level = 3
school = "evocation"
casting_time = "1 action"
spell_range = "Self (100-foot line)"
datacomponents = "V, S, M (a bit of fur and a rod of amber, crystal, or glass)"
duration = "Instantaneous"
description = "A stroke of lightning forming a line 100 feet long and 5 feet wide blasts out from you in a direction you choose. Each creature in the line must make a Dexterity saving throw. A creature takes 8d6 lightning damage on a failed save, or half as much damage on a successful one.\n\nThe lightning ignites flammable objects in the area that aren't being worn or carried."
higher_levels = ""
ritual = "false"
concentration = "false"
classes = ["wizard", "sorcerer"]
damage_dice = "1d6"
damage_type = "acid"
saving_throw = "Dexterity"
attack_roll = "false"
area_of_effect = ""
scales_with_level = "true"
scaling_dice = "1d6"
scaling_levels = [5, 11, 17]
