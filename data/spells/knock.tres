[gd_resource type="Resource" script_class="SpellResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/spell_resource.gd" id="1_spell"]

[resource]
script = ExtResource("1_spell")
spell_name = "Knock"
level = 1
school = "evocation"
casting_time = "1 action"
spell_range = "60 feet"
components = "V"
duration = "Instantaneous"
description = "Choose an object that you can see within range. The object can be a door, a box, a chest, a set of manacles, a padlock, or another object that contains a mundane or magical means that prevents access.

A target that is held shut by a mundane lock or that is stuck or barred becomes unlocked, unstuck, or unbarred. If the object has multiple locks, only one of them is unlocked.

If you choose a target that is held shut with *arcane lock*, that spell is suppressed for 10 minutes, during which time the target can be opened and shut normally.

When you cast the spell, a loud knock, audible from as far away as 300 feet, emanates from the target object."
higher_levels = ""
ritual = "false"
concentration = "false"
classes = ["wizard"]
damage_dice = "1d6"
damage_type = "acid"
saving_throw = "Dexterity"
attack_roll = "false"
area_of_effect = ""
scales_with_level = "true"
scaling_dice = "1d6"
scaling_levels = [5, 11, 17]
