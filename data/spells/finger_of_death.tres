[ext_resource type="Script" path="res://resources/spell_resource.gd" id="1_spell"]

[resource]
script = ExtResource("1_spell")
spell_name = "Finger of Death"
level = 1
school = "evocation"
casting_time = "1 action"
spell_range = "60 feet"
components = "V, S"
duration = "Instantaneous"
description = "You send negative energy coursing through a creature that you can see within range, causing it searing pain. The target must make a Constitution saving throw. It takes 7d8 + 30 necrotic damage on a failed save, or half as much damage on a successful one.

A humanoid killed by this spell rises at the start of your next turn as a zombie that is permanently under your command, following your verbal orders to the best of its ability."
higher_levels = ""
ritual = "false"
concentration = "false"
classes = ["wizard"]
damage_dice = "1d6"
damage_type = "acid"
saving_throw = "Dexterity"
attack_roll = "false"
area_of_effect = ""
scales_with_level = "true"
scaling_dice = "1d6"
scaling_levels = [5, 11, 17]
