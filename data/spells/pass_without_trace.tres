[gd_resource type="Resource" script_class="SpellResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/spell_resource.gd" id="1_spell"]

[resource]
script = ExtResource("1_spell")
spell_name = "Pass without Trace"
level = 1
school = "evocation"
casting_time = "1 action"
spell_range = "Self"
components = "V, S, M (ashes from a burned leaf of mistletoe and a sprig of spruce)"
duration = "Concentration, up to 1 hour"
description = "A veil of shadows and silence radiates from you, masking you and your companions from detection. For the duration, each creature you choose within 30 feet of you (including you) has a +10 bonus to Dexterity (Stealth) checks and can't be tracked except by magical means. A creature that receives this bonus leaves behind no tracks or other traces of its passage."
higher_levels = ""
ritual = "false"
concentration = "false"
classes = ["wizard"]
damage_dice = "1d6"
damage_type = "acid"
saving_throw = "Dexterity"
attack_roll = "false"
area_of_effect = ""
scales_with_level = "true"
scaling_dice = "1d6"
scaling_levels = [5, 11, 17]
