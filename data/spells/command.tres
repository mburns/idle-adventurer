[ext_resource type="Script" path="res://resources/spell_resource.gd" id="1_spell"]

[resource]
script = ExtResource("1_spell")
spell_name = "Command"
level = 1
school = "evocation"
casting_time = "1 action"
spell_range = "60 feet"
components = "V"
duration = "1 round"
description = "You speak a one-word command to a creature you can see within range. The target must succeed on a Wisdom saving throw or follow the command on its next turn. The spell has no effect if the target is undead, if it doesn't understand your language, or if your command is directly harmful to it.\n\nSome typical commands and their effects follow. You might issue a command other than one described here. If you do so, the GM determines how the target behaves. If the target can't follow your command, the spell ends."
higher_levels = ""
ritual = "false"
concentration = "false"
classes = ["wizard"]
damage_dice = "1d6"
damage_type = "acid"
saving_throw = "Dexterity"
attack_roll = "false"
area_of_effect = ""
scales_with_level = "true"
scaling_dice = "1d6"
scaling_levels = [5, 11, 17]
