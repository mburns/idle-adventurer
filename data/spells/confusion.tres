ritual = "false"
concentration = "false"
classes = ["bard", "druid", "sorcerer", "wizard"]
damage_dice = "1d6"
damage_type = "acid"
saving_throw = "Dexterity"
attack_roll = "false"
area_of_effect = ""
scales_with_level = "true"
