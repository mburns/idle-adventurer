[gd_resource type="Resource" script_class="SpellResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/spell_resource.gd" id="1_spell"]

[resource]
script = ExtResource("1_spell")
spell_name = "Counterspell"
level = 3
school = "abjuration"
casting_time = "1 reaction, which you take when you see a creature within 60 feet of you casting a spell"
spell_range = "60 feet"
components = "S"
duration = "Instantaneous"
description = "You attempt to interrupt a creature in the process of casting a spell. If the creature is casting a spell of 3rd level or lower, its spell fails and has no effect. If it is casting a spell of 4th level or higher, make an ability check using your spellcasting ability. The DC equals 10 + the spell's level. On a success, the creature's spell fails and has no effect."
higher_levels = ""
ritual = "false"
concentration = "false"
classes = ["wizard", "sorcerer", "warlock"]
damage_dice = "1d6"
damage_type = "acid"
saving_throw = "Dexterity"
attack_roll = "false"
area_of_effect = ""
scales_with_level = "true"
scaling_dice = "1d6"
scaling_levels = [5, 11, 17]
