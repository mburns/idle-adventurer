[resource]
script = ExtResource("1_spell")
spell_name = "Dispel Evil and Good"
level = 1
school = "evocation"
casting_time = "1 action"
spell_range = "Self"
datacomponents = "V, S, M (holy water or powdered silver and iron)"
duration = "Concentration, up to 1 minute"
description = "Shimmering energy surrounds and protects you from fey, undead, and creatures originating from beyond the Material Plane. For the duration, celestials, elementals, fey, fiends, and undead have disadvantage on attack rolls against you.\n\nYou can end the spell early by using either of the following special functions."
