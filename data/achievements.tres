tion": "Craft 10 items", "category": "ITEMS_CRAFTED", "rarity": "COMMON", "requirements": {"items_crafted": 10}, "rewards": {"xp": 100, "gold": 50}}, {"id": "craft_100", "name": "Master Crafter", "description": "Craft 100 items", "category": "ITEMS_CRAFTED", "rarity": "UNCOMMON", "requirements": {"items_crafted": 100}, "rewards": {"xp": 500, "gold": 200}}, {"id": "craft_legendary", "name": "Legendary Artisan", "description": "Craft a legendary item", "category": "ITEMS_CRAFTED", "rarity": "LEGENDARY", "requirements": {"legendary_items_crafted": 1}, "rewards": {"xp": 1000, "gold": 500, "title": "Legendary Artisan"}}, {"id": "faction_friendly", "name": "Well Connected", "description": "Reach friendly reputation with any faction", "category": "FACTION_REPUTATION", "rarity": "COMMON", "requirements": {"faction_reputation": 20}, "rewards": {"xp": 100, "gold": 50}}, {"id": "faction_exalted", "name": "Faction Champion", "description": "Reach exalted reputation with any faction", "category": "FACTION_REPUTATION", "rarity": "EPIC", "requirements": {"faction_reputation": 100}, "rewards": {"xp": 500, "gold": 200, "title": "Champion"}}, {"id": "faction_all_friendly", "name": "Diplomat", "description": "Reach friendly reputation with all factions", "category": "FACTION_REPUTATION", "rarity": "LEGENDARY", "requirements": {"all_factions_friendly": true}, "rewards": {"xp": 1000, "gold": 500, "title": "Master Diplomat"}}, {"id": "time_1_hour", "name": "Dedicated", "description": "Play for 1 hour", "category": "TIME_PLAYED", "rarity": "COMMON", "requirements": {"time_played": 3600}, "rewards": {"xp": 50, "gold": 25}}, {"id": "time_24_hours", "name": "Devoted", "description": "Play for 24 hours", "category": "TIME_PLAYED", "rarity": "UNCOMMON", "requirements": {"time_played": 86400}, "rewards": {"xp": 200, "gold": 100}}, {"id": "time_168_hours", "name": "Addicted", "description": "Play for 168 hours (1 week)", "category": "TIME_PLAYED", "rarity": "EPIC", "requirements": {"time_played"