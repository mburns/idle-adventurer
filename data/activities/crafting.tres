metadata/yaml_data = [{"id": "blacksmithing", "name": "Blacksmithing", "description": "Craft weapons and armor using smith's tools", "ability": "strength", "daily_progress": 0.05, "cost_per_day": 0, "rewards": {"crafting_skill": 1, "strength_exp": 20, "gold": 8}, "requirements": {"strength": 11, "tools": "smith_tools"}}, {"id": "jewelry_making", "name": "Jewelry Making", "description": "Craft delicate jewelry and precision items", "ability": "dexterity", "daily_progress": 0.04, "cost_per_day": 0, "rewards": {"crafting_skill": 1, "dexterity_exp": 25, "gold": 12}, "requirements": {"dexterity": 13, "tools": "jeweler_tools"}}, {"id": "leatherworking", "name": "Leatherworking", "description": "Craft leather armor and accessories", "ability": "dexterity", "daily_progress": 0.06, "cost_per_day": 0, "rewards": {"crafting_skill": 1, "dexterity_exp": 15, "gold": 6}, "requirements": {"dexterity": 12, "tools": "leatherworker_tools"}}, {"id": "pottery", "name": "Pottery", "description": "Craft pottery and ceramic items", "ability": "intelligence", "daily_progress": 0.05, "cost_per_day": 0, "rewards": {"crafting_skill": 1, "intelligence_exp": 18, "gold": 5}, "requirements": {"intelligence": 11, "tools": "potter_tools"}}, {"id": "weaving", "name": "Weaving", "description": "Weave cloth and textiles", "ability": "dexterity", "daily_progress": 0.05, "cost_per_day": 0, "rewards": {"crafting_skill": 1, "dexterity_exp": 20, "gold": 7}, "requirements": {"dexterity": 12, "tools": "weaver_tools"}}, {"id": "woodworking", "name": "Woodworking", "description": "Craft wooden furniture and tools", "ability": "strength", "daily_progress": 0.04, "cost_per_day": 0, "rewards": {"crafting_skill": 1, "strength_exp": 22, "gold": 9}, "requirements": {"strength": 12, "tools": "woodcarver_tools"}}]
